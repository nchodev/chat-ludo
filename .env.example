# Domains served by Caddy (HTTPS certificates are obtained automatically). Each one needs a DNS A record
# pointing to the server, "DNS only" (grey cloud) on Cloudflare so the real player IP reaches the server.
WEB_DOMAIN=ludo.example.com
API_DOMAIN=api.ludo.example.com
ADMIN_DOMAIN=admin.ludo.example.com
# Email given to Let's Encrypt (certificate expiry notices).
ACME_EMAIL=contact@example.com
# IP addresses allowed to open the admin panel, space-separated (e.g. "41.82.10.5/32"). Default: everyone.
ADMIN_ALLOWED_IPS=

# Continuous database backup to Cloudflare R2 (Litestream). Without a bucket the database is NOT backed up.
# R2 > Manage API tokens > "Object Read & Write" token restricted to the bucket.
LITESTREAM_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Web push keys. Generate once with `npx web-push generate-vapid-keys` and keep them: changing them
# breaks every existing notification subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Wave Business (Checkout API) for deposits. Deposits stay closed until the key, the webhook secret and an https WEB_URL are set.
# API key with the Checkout API, and its request signing secret (only if signing was enabled on the key).
WAVE_API_KEY=
WAVE_SIGNING_SECRET=
# Webhook registered on https://<API_DOMAIN>/api/payments/webhook, "Signing secret" strategy, event checkout.session.completed.
WAVE_WEBHOOK_SECRET=
