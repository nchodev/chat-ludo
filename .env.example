# Public address of the website (allowed to call the game server).
WEB_URL=https://ludo.example.com
# Public address of the game server (sockets + /api), baked into the website at build time.
SERVER_URL=https://api.ludo.example.com
# Set to 1 when the server runs behind a reverse proxy (HTTPS, load balancer).
TRUST_PROXY=1
